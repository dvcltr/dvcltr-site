---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('status', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id.replace(/\.md$/, '') }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} | dvcltr`} description={post.data.summary}>
  <section class="post-shell">
    <aside class="post-side">
      <h2>Weekly status</h2>
      <p>
        {post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
        {post.data.course ? ` · ${post.data.course}` : ''}
      </p>
      <div class="badges">
        {post.data.tags.map((tag) => <span class="badge">{tag}</span>)}
      </div>
    </aside>

    <article class="post">
      <p class="eyebrow">Public progress update</p>
      <h1>{post.data.title}</h1>
      <p class="summary">{post.data.summary}</p>
      <div class="post-content">
        <Content />
      </div>
    </article>
  </section>
</BaseLayout>
