---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('status'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="School Status | dvcltr">
  <section class="page-heading">
    <p class="eyebrow">School status archive</p>
    <h1>School weekly status</h1>
    <p>Public, privacy-safe updates on coursework, cybersecurity labs, and current school learning.</p>
  </section>

  <div class="status-list archive-list school-status-list">
    {posts.map((post) => (
      <a class="status-item" href={`/status/${post.id.replace(/\.md$/, '')}/`}>
        <div class="status-meta">
          {post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}
          {post.data.course ? ` · ${post.data.course}` : ''}
        </div>
        <h2>{post.data.title}</h2>
        <p>{post.data.summary}</p>
        <div class="badges">
          {post.data.tags.map((tag) => <span class="badge">{tag}</span>)}
        </div>
      </a>
    ))}
  </div>
</BaseLayout>
