---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projectPosts = (await getCollection('projectStatus'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const latestProject = projectPosts[0];
---

<BaseLayout title="Personal Projects | dvcltr" description="Personal projects, cyber range builds, and project status updates from dvcltr.">
  <section class="page-heading">
    <p class="eyebrow">Personal projects</p>
    <h1>Projects<span class="signal">.</span></h1>
    <p>Side projects, build notes, and experiments that connect coursework with practical hands-on work.</p>
  </section>

  <section class="personal-projects page-section-tight">
    <article class="project-feature">
      <div>
        <p class="status-meta">Featured project</p>
        <h3>Cipherstone Lab</h3>
        <p>
          Cipherstone Lab is a browser-based cyber range built around a fictional university training
          scenario. It uses a terminal-style interface to practice enumeration, host discovery,
          credential reasoning, basic Linux navigation, and end-of-scenario debriefing.
        </p>
        <div class="project-tags" aria-label="Cipherstone Lab topics">
          <span>React / Next.js</span>
          <span>Terminal UI</span>
          <span>Cyber range</span>
          <span>Training scenario</span>
        </div>
      </div>
      <div class="project-actions">
        <a class="btn primary" href="/projects/cipherstone-lab/">View project</a>
        <a class="btn secondary" href="https://cipherstone-cyber-range.vercel.app" target="_blank" rel="noreferrer">Play the game</a>
        <a class="btn secondary" href="https://github.com/dvcltr/cipherstone-cyber-range" target="_blank" rel="noreferrer">View source</a>
      </div>
    </article>

    <article class="project-feature">
      <div>
        <p class="status-meta">Homelab infrastructure</p>
        <h3>Always-on Hermes Agent</h3>
        <p>
          Migrated Hermes from a single workstation into an always-on Debian virtual machine on
          Proxmox. The project preserved agent state and development work, moved messaging through a
          rollback-safe cutover, kept local desktop control for machine-specific tasks, and restricted
          remote access to a private Tailscale network.
        </p>
        <div class="project-tags" aria-label="Always-on Hermes Agent topics">
          <span>Proxmox</span>
          <span>Debian</span>
          <span>Hermes Agent</span>
          <span>Tailscale</span>
          <span>systemd</span>
          <span>Secure migration</span>
        </div>
      </div>
      <div class="project-actions">
        <a class="btn primary" href="/projects/always-on-hermes/">View project</a>
        <a class="btn secondary" href="/projects/status/2026-09-24-always-on-hermes-proxmox/">Read the build notes</a>
      </div>
    </article>

    <article class="project-feature lab-portfolio">
      <div>
        <p class="status-meta">Lab portfolio</p>
        <h3>Vulnerable Lab Environment</h3>
        <p>
          A preserved collection of intentionally vulnerable applications and cloud environments for
          hands-on practice with API security, prompt injection, DeFi exploits, and AWS and Azure
          misconfigurations. Each upstream project is forked to my GitHub account so the lab material
          remains available for future study.
        </p>
        <div class="project-tags" aria-label="Cybersecurity Elective Lab topics">
          <span>API security</span>
          <span>LLM security</span>
          <span>DeFi</span>
          <span>Cloud security</span>
          <span>Docker labs</span>
        </div>
      </div>
      <div class="project-actions" aria-label="Cybersecurity Elective Lab repositories">
        <a class="btn primary" href="/projects/vulnerable-lab-environment/">View project</a>
        <a class="btn secondary" href="https://github.com/dvcltr/VAmPI" target="_blank" rel="noreferrer">VAmPI</a>
        <a class="btn secondary" href="https://github.com/dvcltr/DamnVulnerableLLMProject" target="_blank" rel="noreferrer">Damn Vulnerable LLM</a>
        <a class="btn secondary" href="https://github.com/dvcltr/DVAPI" target="_blank" rel="noreferrer">DVAPI</a>
        <a class="btn secondary" href="https://github.com/dvcltr/damn-vulnerable-defi" target="_blank" rel="noreferrer">Damn Vulnerable DeFi</a>
        <a class="btn secondary" href="https://github.com/dvcltr/AzureGoat" target="_blank" rel="noreferrer">AzureGoat</a>
        <a class="btn secondary" href="https://github.com/dvcltr/AWSGoat" target="_blank" rel="noreferrer">AWSGoat</a>
      </div>
    </article>
  </section>

  <section class="page-section-tight">
    <div class="section-head">
      <h2>Project status</h2>
      <p>Weekly-style updates for site work, personal builds, GitHub changes, and deployments.</p>
    </div>
    <div class="status-list archive-list">
      {projectPosts.map((post) => (
        <a class="status-item" href={`/projects/status/${post.id.replace(/\.md$/, '')}/`}>
          <div class="status-meta">
            {post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}
            {post.data.project ? ` · ${post.data.project}` : ''}
          </div>
          <h2>{post.data.title}</h2>
          <p>{post.data.summary}</p>
          <div class="badges">
            {post.data.tags.map((tag) => <span class="badge">{tag}</span>)}
          </div>
        </a>
      ))}
    </div>
    {latestProject && (
      <p class="archive-note"><a href="/projects/status/">View the personal project status archive</a>.</p>
    )}
  </section>
</BaseLayout>
