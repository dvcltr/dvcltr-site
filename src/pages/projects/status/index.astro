---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const posts = (await getCollection('projectStatus'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Project Status | dvcltr" description="Personal project status updates for dvcltr site work, Cipherstone Lab, GitHub, and Vercel deployments.">
  <section class="page-heading">
    <p class="eyebrow">Project status archive</p>
    <h1>Personal project status</h1>
    <p>Updates on personal builds, site work, GitHub workflow, Vercel deployments, and project milestones.</p>
  </section>

  <div class="status-list archive-list">
    {posts.map((post) => (
      <a class="status-item" href={`/projects/status/${post.id.replace(/\.md$/, '')}/`}>
        <div class="status-meta">
          {post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}
          {post.data.project ? ` · ${post.data.project}` : ''}
        </div>
        <h2>{post.data.title}</h2>
        <p>{post.data.summary}</p>
        <div class="badges">
          {post.data.tags.map((tag) => <span class="badge">{tag}</span>)}
        </div>
      </a>
    ))}
  </div>
</BaseLayout>
