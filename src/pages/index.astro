---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const schoolPosts = (await getCollection('status'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const projectPosts = (await getCollection('projectStatus'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latestSchool = schoolPosts[0];
const latestProject = projectPosts[0];
---

<BaseLayout>
  <section class="home-hero" id="top">
    <h1 class="home-title">Dave<br />Coulter<span class="signal">.</span></h1>
    <div class="hero-foot">
      <a href="#about"><b>↓</b>&nbsp; Scroll to explore</a>
      <span>Portfolio / 2026</span>
    </div>
  </section>

  <section class="numbered-section" id="about">
    <div class="section-grid">
      <p class="kicker">01 / About</p>
      <a class="about-row" href="/about/">
        <p>Husband, father, Navy veteran, and cybersecurity nerd.</p>
        <b aria-hidden="true">↗</b>
      </a>
    </div>
  </section>

  <section class="numbered-section" id="work">
    <div class="section-grid">
      <p class="kicker">02 / Selected work</p>
      <div>
        <div class="filter-list" aria-label="Filter selected work">
          <button class="active" type="button" data-filter="all">All</button>
          <button type="button" data-filter="build">Builds</button>
          <button type="button" data-filter="lab">Labs</button>
        </div>
        <div class="work-list">
          <a class="work-row" data-kind="build" href="/projects/cipherstone-lab/">
            <h2>Cipherstone Lab</h2><p>Browser cyber range</p><span>Next.js / 2026</span><b>↗</b>
          </a>
          <a class="work-row" data-kind="build" href="/projects/always-on-hermes/">
            <h2>Always-on Hermes</h2><p>Private AI infrastructure</p><span>Proxmox / 2026</span><b>↗</b>
          </a>
          <a class="work-row" data-kind="lab" href="/projects/vulnerable-lab-environment/">
            <h2>Vulnerable Lab Environment</h2><p>Hands-on security practice</p><span>Lab portfolio / Ongoing</span><b>↗</b>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="numbered-section" id="stack">
    <div class="section-grid">
      <p class="kicker">03 / Technology stack</p>
      <div class="stack-summary">
        <p>An evolving mix of technology, tools, and gadgets for work, projects, school, and the homelab.</p>
        <a class="text-link" href="/stack/">Explore the full stack ↗</a>
      </div>
    </div>
  </section>

  <section class="numbered-section" id="notes">
    <div class="section-grid">
      <p class="kicker">04 / Latest notes</p>
      <div class="notes-grid">
        {latestSchool && (
          <a class="status-item" href={`/status/${latestSchool.id.replace(/\.md$/, '')}/`}>
            <div class="status-meta">School · {latestSchool.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</div>
            <h2>{latestSchool.data.title}</h2>
            <p>{latestSchool.data.summary}</p>
            <div class="badges">{latestSchool.data.tags.map((tag) => <span class="badge">{tag}</span>)}</div>
          </a>
        )}
        {latestProject && (
          <a class="status-item" href={`/projects/status/${latestProject.id.replace(/\.md$/, '')}/`}>
            <div class="status-meta">Project · {latestProject.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</div>
            <h2>{latestProject.data.title}</h2>
            <p>{latestProject.data.summary}</p>
            <div class="badges">{latestProject.data.tags.map((tag) => <span class="badge">{tag}</span>)}</div>
          </a>
        )}
      </div>
    </div>
  </section>

  <script is:inline>
    document.querySelectorAll('[data-filter]').forEach((button) => {
      button.addEventListener('click', () => {
        document.querySelectorAll('[data-filter]').forEach((item) => item.classList.remove('active'));
        button.classList.add('active');
        document.querySelectorAll('[data-kind]').forEach((item) => {
          item.style.display = button.dataset.filter === 'all' || item.dataset.kind === button.dataset.filter ? 'grid' : 'none';
        });
      });
    });
  </script>
</BaseLayout>
