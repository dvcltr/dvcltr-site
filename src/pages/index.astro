---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('status'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);
---

<BaseLayout>
  <section class="hero hero-simple">
    <div class="hero-text">
      <p class="eyebrow">Weekly learning log</p>
      <h1>A weekly log of projects, labs, and lessons learned.</h1>
      <p>
        Straightforward public updates on completed coursework, cybersecurity topics practiced,
        and what I am learning next.
      </p>
      <div class="hero-actions">
        <a class="btn primary" href="#status">Read latest updates</a>
        <a class="btn secondary" href="/status/">View full archive</a>
      </div>
    </div>
  </section>

  <section id="degree" class="degree-progress">
    <div class="section-head">
      <h2>Degree progress</h2>
    </div>

    <div class="progress-card">
      <div class="progress-summary">
        <span class="status-meta">Completed courses</span>
        <strong>3 / 10</strong>
      </div>
      <div class="degree-bar" aria-label="Degree progress: 3 courses completed, CYBR-508 in progress, 6 courses upcoming">
        <span class="degree-fill completed" style="width: 30%;"></span>
        <span class="degree-fill current" style="left: 30%; width: 10%;"></span>
      </div>
      <div class="course-track" aria-label="CYBR course sequence">
        <span class="course-pill done">CYBR-501</span>
        <span class="course-pill done">CYBR-502</span>
        <span class="course-pill upcoming">CYBR-503</span>
        <span class="course-pill upcoming">CYBR-504</span>
        <span class="course-pill done">CYBR-506</span>
        <span class="course-pill current">CYBR-508</span>
        <span class="course-pill upcoming">CYBR-510</span>
        <span class="course-pill upcoming">CYBR-512</span>
        <span class="course-pill upcoming">CYBR-514</span>
        <span class="course-pill upcoming">CYBR-516</span>
      </div>
    </div>
  </section>

  <section id="projects">
    <div class="section-head">
      <h2>Project areas</h2>
    </div>
    <div class="grid">
      <div class="card">
        <h3>Security labs</h3>
        <p>Hands-on work with networking, monitoring, access control, and defensive tools.</p>
      </div>
      <div class="card">
        <h3>Wargame practice</h3>
        <p>Command-line and web security exercises focused on careful enumeration and problem solving.</p>
      </div>
      <div class="card">
        <h3>Technical documentation</h3>
        <p>Short writeups that explain what I practiced, what I learned, and what comes next.</p>
      </div>
    </div>
  </section>

  <section id="learning">
    <div class="section-head">
      <h2>Currently learning</h2>
    </div>
    <div class="card">
      <ul>
        <li>Secure network engineering fundamentals</li>
        <li>Intrusion detection and system monitoring</li>
        <li>VPN security, logging, and visibility</li>
        <li>Clear public-facing technical summaries</li>
      </ul>
    </div>
  </section>

  <section id="status">
    <div class="section-head">
      <h2>Latest weekly status</h2>
      <p>Showing the latest six weekly status updates. <a href="/status/">View the full archive</a>.</p>
    </div>
    <div class="status-list">
      {posts.map((post) => (
        <a class="status-item" href={`/status/${post.id.replace(/\.md$/, '')}/`}>
          <div class="status-meta">{post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</div>
          <h2>{post.data.title}</h2>
          <p>{post.data.summary}</p>
          <div class="badges">
            {post.data.tags.map((tag) => <span class="badge">{tag}</span>)}
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
