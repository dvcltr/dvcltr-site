---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('status'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);
---

<BaseLayout>
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow">Weekly learning log</p>
      <h1>A weekly log of projects, labs, and lessons learned.</h1>
      <p>
        Straightforward public updates on completed coursework, cybersecurity topics practiced,
        and what I am learning next.
      </p>
      <div class="hero-actions">
        <a class="btn primary" href="#status">Read latest updates</a>
        <a class="btn secondary" href="/status/">View full archive</a>
      </div>
    </div>

    <aside class="hero-panel" aria-label="Learning overview">
      <div class="trail-card">
        <h2>Learning map</h2>
        <div class="trail-item">Secure network engineering</div>
        <div class="trail-item">Intrusion detection and monitoring</div>
        <div class="trail-item">VPN security and visibility</div>
        <div class="trail-item">Hands-on practice and documentation</div>
      </div>
      <div class="ticket">
        <small>current archive</small>
        <strong>{posts.length} recent updates</strong>
        <small>reviewed before publishing</small>
      </div>
    </aside>
  </section>

  <section id="projects">
    <div class="section-head">
      <h2>Project areas</h2>
      <p>Hands-on coursework, security practice, and short public-facing summaries.</p>
    </div>
    <div class="grid">
      <div class="card">
        <h3>Security labs</h3>
        <p>Hands-on work with networking, monitoring, access control, and defensive tools.</p>
      </div>
      <div class="card">
        <h3>Wargame practice</h3>
        <p>Command-line and web security exercises focused on careful enumeration and problem solving.</p>
      </div>
      <div class="card">
        <h3>Technical documentation</h3>
        <p>Short writeups that explain what I practiced, what I learned, and what comes next.</p>
      </div>
    </div>
  </section>

  <section id="learning" class="learning-grid">
    <div class="note-panel">
      <h2>Currently learning</h2>
      <p>Secure network engineering, monitoring, VPN visibility, and public-safe technical communication.</p>
    </div>
    <div class="focus-panel">
      <h2>Focus areas</h2>
      <ul>
        <li>Secure network engineering fundamentals</li>
        <li>Intrusion detection and system monitoring</li>
        <li>VPN security, logging, and visibility</li>
        <li>Clear public-facing technical summaries</li>
      </ul>
    </div>
  </section>

  <section id="status">
    <div class="section-head">
      <h2>Latest weekly status</h2>
      <p>Showing the latest six weekly status updates. <a href="/status/">View the full archive</a>.</p>
    </div>
    <div class="status-list">
      {posts.map((post) => (
        <a class="status-item" href={`/status/${post.id.replace(/\.md$/, '')}/`}>
          <div class="status-meta">{post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</div>
          <h2>{post.data.title}</h2>
          <p>{post.data.summary}</p>
          <div class="badges">
            {post.data.tags.map((tag) => <span class="badge">{tag}</span>)}
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
