---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const schoolPosts = (await getCollection('status'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const projectPosts = (await getCollection('projectStatus'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const latestSchool = schoolPosts[0];
const latestProject = projectPosts[0];
---

<BaseLayout>
  <section class="hero hero-simple">
    <div class="hero-text">
      <p class="eyebrow">Portfolio and creative archive</p>
      <h1>Curious, hands-on, and always building.</h1>
      <p>
        I’m a father, Navy veteran, cybersecurity engineering student, and tinkerer.
      </p>
      <p>
        I spent 20 years in the Navy as an IT and now study cybersecurity engineering, with
        interests in homelabbing, critical infrastructure, and hands-on technical work. dvcltr.com
        is my portfolio and creative archive: a place for projects, notes, experiments, and whatever
        I’m learning by taking things apart.
      </p>
      <div class="hero-actions">
        <a class="btn primary" href="#updates">Read latest updates</a>
        <a class="btn secondary" href="/projects/">View personal projects</a>
      </div>
    </div>
  </section>

  <section id="school" class="school-overview">
    <div class="section-head">
      <h2>School progress</h2>
      <p>Degree progress, lab hardware, and school weekly statuses stay grouped together.</p>
    </div>

    <div class="overview-grid">
      <article class="progress-card">
        <div class="progress-summary">
          <span class="status-meta">Completed courses</span>
          <strong>3 / 10</strong>
        </div>
        <div class="degree-bar" aria-label="Degree progress: 3 courses completed, CYBR-508 in progress, 6 courses upcoming">
          <span class="degree-fill completed" style="width: 30%;"></span>
          <span class="degree-fill current" style="left: 30%; width: 10%;"></span>
        </div>
        <div class="course-track" aria-label="CYBR course sequence">
          <span class="course-pill done">CYBR-501</span>
          <span class="course-pill done">CYBR-502</span>
          <span class="course-pill upcoming">CYBR-503</span>
          <span class="course-pill upcoming">CYBR-504</span>
          <span class="course-pill done">CYBR-506</span>
          <span class="course-pill current">CYBR-508</span>
          <span class="course-pill upcoming">CYBR-510</span>
          <span class="course-pill upcoming">CYBR-512</span>
          <span class="course-pill upcoming">CYBR-514</span>
          <span class="course-pill upcoming">CYBR-516</span>
        </div>
      </article>

      {latestSchool && (
        <a class="status-item featured-status" href={`/status/${latestSchool.id.replace(/\.md$/, '')}/`}>
          <div class="status-meta">Latest school status</div>
          <h2>{latestSchool.data.title}</h2>
          <p>{latestSchool.data.summary}</p>
          <div class="badges">
            {latestSchool.data.tags.map((tag) => <span class="badge">{tag}</span>)}
          </div>
        </a>
      )}
    </div>
  </section>

  <section id="technology" class="technology-stack compact-stack">
    <div class="section-head">
      <h2>Technology stack</h2>
      <p>The current school and home-lab setup used for coursework and practice.</p>
    </div>

    <div class="tech-panel">
      <div class="tech-grid">
        <article class="tech-card tech-warm">
          <div class="tech-card-head">
            <div>
              <h3>ThinkPad X270</h3>
              <p>Windows coursework laptop</p>
            </div>
            <span>School endpoint</span>
          </div>
          <div class="spec-grid" aria-label="ThinkPad X270 specifications">
            <div class="spec"><strong>CPU</strong><span>Intel i7 10th gen</span></div>
            <div class="spec"><strong>RAM</strong><span>16GB</span></div>
            <div class="spec"><strong>SSD</strong><span>512GB</span></div>
          </div>
        </article>

        <article class="tech-card tech-green">
          <div class="tech-card-head">
            <div>
              <h3>ThinkPad T490</h3>
              <p>Omarchy workstation with Docker</p>
            </div>
            <span>Primary lab host</span>
          </div>
          <div class="spec-grid" aria-label="ThinkPad T490 specifications">
            <div class="spec"><strong>CPU</strong><span>Intel i7 10th gen</span></div>
            <div class="spec"><strong>RAM</strong><span>48GB</span></div>
            <div class="spec"><strong>SSD</strong><span>1TB</span></div>
          </div>
        </article>

        <article class="tech-card tech-gold">
          <div class="tech-card-head">
            <div>
              <h3>VirtualBox lab stack</h3>
              <p>Local security practice environments</p>
            </div>
            <span>Lab VMs</span>
          </div>
          <div class="tool-chips" aria-label="VirtualBox lab tools">
            <span>Kali</span>
            <span>ParrotOS</span>
            <span>Labtainer</span>
            <span>Wazuh</span>
            <span>VulnHub</span>
            <span>Metasploitable</span>
            <span>Dragon OS</span>
            <span>BlackArch</span>
          </div>
        </article>

        <article class="tech-card tech-green">
          <div class="tech-card-head">
            <div>
              <h3>ZimaBlade</h3>
              <p>Proxmox mini home server</p>
            </div>
            <span>Home lab</span>
          </div>
          <div class="spec-grid" aria-label="ZimaBlade specifications">
            <div class="spec"><strong>CPU</strong><span>N3450</span></div>
            <div class="spec"><strong>RAM</strong><span>32GB</span></div>
            <div class="spec"><strong>Storage</strong><span>2 × 4TB HDD</span></div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section id="projects" class="personal-projects">
    <div class="section-head">
      <h2>Personal projects</h2>
      <p>Side projects and build logs live separately from school coursework.</p>
    </div>

    <article class="project-feature">
      <div>
        <p class="status-meta">Browser cyber range</p>
        <h3>Cipherstone Lab</h3>
        <p>
          A fictional university security lab built as a browser-based terminal game. The project
          turns beginner cybersecurity practice into an interactive investigation: reading help text,
          exploring hosts, mapping what is discovered, and solving small Linux/networking challenges
          inside an authorized training scenario.
        </p>
        <div class="project-tags" aria-label="Cipherstone Lab topics">
          <span>React / Next.js</span>
          <span>Terminal UI</span>
          <span>Cybersecurity labs</span>
          <span>Scenario design</span>
        </div>
      </div>
      <div class="project-actions">
        <a class="btn primary" href="/projects/">View projects</a>
        <a class="btn secondary" href="https://cipherstone-cyber-range.vercel.app" target="_blank" rel="noreferrer">Open Cipherstone Lab</a>
      </div>
    </article>
  </section>

  <section id="updates">
    <div class="section-head">
      <h2>Latest from both logs</h2>
      <p>Homepage previews only the newest school update and newest personal project update.</p>
    </div>
    <div class="status-list paired-status-list">
      {latestSchool && (
        <a class="status-item" href={`/status/${latestSchool.id.replace(/\.md$/, '')}/`}>
          <div class="status-meta">School weekly status · {latestSchool.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</div>
          <h2>{latestSchool.data.title}</h2>
          <p>{latestSchool.data.summary}</p>
          <div class="badges">
            {latestSchool.data.tags.map((tag) => <span class="badge">{tag}</span>)}
          </div>
        </a>
      )}
      {latestProject && (
        <a class="status-item" href={`/projects/status/${latestProject.id.replace(/\.md$/, '')}/`}>
          <div class="status-meta">Personal project status · {latestProject.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</div>
          <h2>{latestProject.data.title}</h2>
          <p>{latestProject.data.summary}</p>
          <div class="badges">
            {latestProject.data.tags.map((tag) => <span class="badge">{tag}</span>)}
          </div>
        </a>
      )}
    </div>
  </section>
</BaseLayout>
