---
import '../styles/ink-signal.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Dave Coulter | Cybersecurity Engineer',
  description = 'Portfolio, projects, schoolwork, homelab notes, and technology from cybersecurity engineer Dave Coulter.',
} = Astro.props;

const path = Astro.url.pathname;
const isActive = (prefix: string) => prefix === '/' ? path === '/' : path.startsWith(prefix);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  </head>
  <body>
    <div class="site-shell">
      <nav class="site-nav" aria-label="Main navigation">
        <a class="site-brand" href="/" aria-current={isActive('/') ? 'page' : undefined}>DVCLTR.</a>
        <span class="site-role">Cybersecurity<br />Engineer.</span>
        <a class="site-contact" href="mailto:dvcltr@gmail.com">dvcltr@gmail.com<br />San Diego, CA</a>
        <div class="site-links">
          <a href="/projects/" aria-current={isActive('/projects/') ? 'page' : undefined}>Work</a>
          <a href="/school/" aria-current={isActive('/school/') || isActive('/status/') ? 'page' : undefined}>School</a>
          <a href="/stack/" aria-current={isActive('/stack/') ? 'page' : undefined}>Stack</a>
          <a href="/about/" aria-current={isActive('/about/') ? 'page' : undefined}>About</a>
        </div>
      </nav>
      <main><slot /></main>
      <footer class="site-footer"><span>© 2026 DVCLTR</span><span>Built by taking things apart.</span></footer>
    </div>
  </body>
</html>
