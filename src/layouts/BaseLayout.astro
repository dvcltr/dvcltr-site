---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'dvcltr | School Progress',
  description = 'A public weekly status log for school projects, cybersecurity labs, and what I am learning.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="site-shell">
      <nav class="nav" aria-label="Main navigation">
        <a class="brand" href="/">dvcltr</a>
        <div class="nav-links">
          <a href="/status/">weekly status</a>
          <a href="/#projects">projects</a>
          <a href="/#learning">learning</a>
        </div>
      </nav>
      <slot />
      <footer class="footer">
        <span>student@dvcltr:~$ logout</span>
      </footer>
    </div>
  </body>
</html>
